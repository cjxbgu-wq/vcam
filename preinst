#!/bin/bash
# VCamPlus 预安装: 为 data.tar 纯文件条目(零目录条目)建父目录
# 背景(2026-08-18): 数据包剥离全部目录条目(RootHide /var/jb 符号链接的
# overwrite 冲突), dpkg 不自动建父目录, 依赖本脚本 mkdir 兜底。
# 布局(2026-08-21, 1.3.19 纯千面式): data.tar 只带
# ./Library/MobileSubstrate/DynamicLibraries 条目 ——
#   rootless: rootless-compat/bootstrap 重定向落 /var/jb/Library/...
#   rootful: 直写 /Library/...
# SE2 实证(1.3.17/1.3.18): /var/jb/usr/lib/TweakInject 链路破损
# (mkdir ENOENT 被 2>/dev/null 吞掉, dpkg 直写必失败), 故 data.tar 不再携带
# 任何 var/jb 条目; TweakInject 副本由 postinst 探测写入(可写才写)。
mkdir -p /var/jb/Library/MobileSubstrate/DynamicLibraries 2>/dev/null || true
mkdir -p /Library/MobileSubstrate/DynamicLibraries 2>/dev/null || true
mkdir -p /var/jb/usr/lib/TweakInject 2>/dev/null || true

exit 0

#!/bin/bash
# VCamPlus 卸载后处理(2026-08-18 重写: 不做任何 respring)
#
# 事故复盘: 旧版在 postrm 里 sleep 2 后 killall -9 SpringBoard —— 但 postrm 运行时
# dpkg 事务尚未收尾(status 数据库还没写完), respring 连带杀掉 Sileo/apt 进程,
# dpkg status 写入被中断 → ellekit 启动校验读到损坏的包记录 →
# "Ellekit files are corrupted for unknown reasons. Please try reinstalling
# the ellekit package" 且所有 App 闪退(设备实证, 只能重装越狱恢复)。
#
# 正确做法: 卸载后不 respring ——
#   - Sileo 卸载: dpkg 完全退出后由 Sileo 自己 respring(时机安全)
#   - dpkg -r 直装: dylib 文件已删, 当前进程内旧副本无害, 下次自然重启生效;
#     如需立即生效手动 respring 即可
# 升级场景(prerm remove + 立即 unpack 新版)同样不重启, 由新版 postinst 统一处理

# 1.3.19: postinst 探测复制的 TweakInject 副本不受 dpkg 跟踪, 手动清理
# 1.3.22 CRITICAL 修复: rm 必须限定 remove/purge 场景! dpkg 升级流程会跑
# 旧包的 postrm(在解包新文件之后), 而 /var/jb/usr/lib/TweakInject 在部分
# bootstrap(/var/jb -> /)下与 DynamicLibraries 落点是同一物理目录(符号链接
# 别名), 无条件 rm 会把刚解包的正本删掉 —— 1.3.19~1.3.21 的"安装成功但
# 文件消失"正是此机制(升级必吃文件, 全新安装则正常)。
if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
    rm -f /var/jb/usr/lib/TweakInject/VCamPlus.dylib 2>/dev/null || true
    rm -f /var/jb/usr/lib/TweakInject/VCamPlus.plist 2>/dev/null || true
fi

exit 0
